# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Variables prefixed with EXPO_PUBLIC_ are embedded in the app bundle:
# only put values here that are safe to ship to the client.

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Supabase (Project Settings → API). Use the anon/publishable key, never the service role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (Phase 3 — payments). Leave empty for now.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Public URLs shown on the paywall / settings (required by the App Store before release).
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# ---------------------------------------------------------------------------
# NOT for this file: server-side secrets (Supabase service role key, USDA API
# key for future catalogue imports, RevenueCat webhook secret) must live only
# in Supabase Edge Function secrets / your server — never in EXPO_PUBLIC_*.
